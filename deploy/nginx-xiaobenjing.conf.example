# 小本经 — 腾讯云 Ubuntu / Nginx
# 备案期间：用公网 IP 访问（default_server）
# 备案通过后：把 server_name 改成域名，再上 HTTPS

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    # 备案前可先写 _ 或公网 IP；备案后改为：
    # server_name xiaobenjing.com www.xiaobenjing.com;
    server_name _;

    root /var/www/xiaobenjing;
    index index.html;

    # SPA：静态文件不存在时回退 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /images/ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    location ~* \.(xml|txt|svg|ico)$ {
        expires 1d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 安全头（可选）
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
}

# ---------- 备案通过 + 证书就绪后启用（示例）----------
# 1) 腾讯云申请免费 SSL，或：sudo apt install certbot python3-certbot-nginx
# 2) certbot --nginx -d xiaobenjing.com -d www.xiaobenjing.com
