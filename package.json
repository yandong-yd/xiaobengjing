{
  "name": "baitan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-html.mjs",
    "preview": "vite preview",
    "preview:dist": "npm run build && vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:seo": "vitest run src/lib/seo.test.js",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run audit:covers && npm run audit:content && npm run build",
    "download:covers": "node scripts/download-covers.mjs",
    "covers:map": "node scripts/build-cover-map.mjs",
    "covers:suggest": "node scripts/suggest-covers.mjs",
    "audit:covers": "node scripts/audit-covers.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "content:health": "node scripts/content-health.mjs",
    "prerender": "node scripts/prerender-html.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  }
}
