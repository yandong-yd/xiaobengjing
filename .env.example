VITE_SITE_URL=https://www.xiaobenjing.com

# 百度统计 hm.js ID（生产环境自动加载）
VITE_BAIDU_HM_ID=d742c9d19ada9f61cc4d6d18b94154e0

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI（配置后 AI 页面使用真实 API，未配置则演示模式）
VITE_OPENAI_API_KEY=your_openai_api_key
# 国内可用中转 API，留空则用官方 https://api.openai.com/v1
VITE_OPENAI_BASE_URL=
# 默认 gpt-4o-mini
VITE_OPENAI_MODEL=gpt-4o-mini

# 封面 CDN（腾讯云 COS 自定义域名，末尾不要 /）
# 配置后 /images/covers/xxx.jpg → {CDN}/images/covers/xxx.jpg
# VITE_COVER_CDN=https://cdn.xiaobenjing.com

# 封面候选搜索（npm run covers:suggest，二选一）
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
